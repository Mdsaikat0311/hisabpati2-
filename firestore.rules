rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function isValidAccount(data) {
      return data.keys().hasAll(['userId', 'name', 'type', 'balance', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'userId', 'name', 'type', 'institution', 'balance', 'openingBalance',
          'accountNumberLast4', 'colorHex', 'iconName', 'isHidden', 'sortOrder',
          'creditLimit', 'billingDate', 'paymentDueDate', 'minPayment', 'notes',
          'includeInTotal', 'createdAt', 'updatedAt'
        ])
        && data.userId is string && data.userId == request.auth.uid
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.type in ['BANK', 'CREDIT_CARD', 'DEBIT_CARD', 'CASH', 'MFS', 'OTHER']
        && data.balance is number && data.balance >= -100000000000 && data.balance <= 100000000000
        && (!('institution' in data) || (data.institution is string && data.institution.size() <= 100))
        && (!('openingBalance' in data) || data.openingBalance is number)
        && (!('accountNumberLast4' in data) || (data.accountNumberLast4 is string && data.accountNumberLast4.size() <= 10))
        && (!('colorHex' in data) || (data.colorHex is string && data.colorHex.size() <= 20))
        && (!('iconName' in data) || (data.iconName is string && data.iconName.size() <= 50))
        && (!('isHidden' in data) || data.isHidden is bool)
        && (!('sortOrder' in data) || data.sortOrder is int)
        && (!('creditLimit' in data) || (data.creditLimit is number && data.creditLimit >= 0))
        && (!('billingDate' in data) || (data.billingDate is string && data.billingDate.size() <= 30))
        && (!('paymentDueDate' in data) || (data.paymentDueDate is string && data.paymentDueDate.size() <= 30))
        && (!('minPayment' in data) || (data.minPayment is number && data.minPayment >= 0))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000))
        && (!('includeInTotal' in data) || data.includeInTotal is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['userId', 'type', 'amount', 'title', 'accountId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'userId', 'type', 'amount', 'title', 'category', 'subcategory',
          'accountId', 'toAccountId', 'timestamp', 'notes', 'isRecurring',
          'payeeOrPayer', 'debtId', 'createdAt', 'updatedAt'
        ])
        && data.userId is string && data.userId == request.auth.uid
        && data.type in ['EXPENSE', 'INCOME', 'TRANSFER', 'LEND', 'BORROW', 'CC_PAYMENT']
        && data.amount is number && data.amount >= 0 && data.amount <= 100000000000
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.accountId is string && data.accountId.size() > 0 && data.accountId.size() <= 100
        && (!('category' in data) || (data.category is string && data.category.size() <= 100))
        && (!('subcategory' in data) || (data.subcategory is string && data.subcategory.size() <= 100))
        && (!('toAccountId' in data) || data.toAccountId == null || (data.toAccountId is string && data.toAccountId.size() <= 100))
        && (!('timestamp' in data) || data.timestamp is int || data.timestamp is number)
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000))
        && (!('isRecurring' in data) || data.isRecurring is bool)
        && (!('payeeOrPayer' in data) || (data.payeeOrPayer is string && data.payeeOrPayer.size() <= 100))
        && (!('debtId' in data) || data.debtId == null || (data.debtId is string && data.debtId.size() <= 100))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBackup(data) {
      return data.keys().hasAll(['userId', 'backupJson', 'uploadedAt', 'uploadedAtMillis'])
        && data.keys().hasOnly([
          'userId', 'backupJson', 'backupDate', 'accountsCount', 'transactionsCount',
          'categoriesCount', 'debtsCount', 'fileSizeBytes', 'uploadedAt', 'uploadedAtMillis'
        ])
        && data.userId is string && data.userId == request.auth.uid
        && data.backupJson is string && data.backupJson.size() > 0 && data.backupJson.size() <= 900000
        && (!('backupDate' in data) || (data.backupDate is string && data.backupDate.size() <= 64))
        && (!('accountsCount' in data) || (data.accountsCount is int && data.accountsCount >= 0))
        && (!('transactionsCount' in data) || (data.transactionsCount is int && data.transactionsCount >= 0))
        && (!('categoriesCount' in data) || (data.categoriesCount is int && data.categoriesCount >= 0))
        && (!('debtsCount' in data) || (data.debtsCount is int && data.debtsCount >= 0))
        && (!('fileSizeBytes' in data) || (data.fileSizeBytes is int && data.fileSizeBytes >= 0))
        && data.uploadedAt is timestamp
        && data.uploadedAtMillis is int;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);

      match /accounts/{accountId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(accountId) && isValidAccount(request.resource.data);
        allow update: if isOwner(userId)
          && isValidId(accountId)
          && isValidAccount(request.resource.data)
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isOwner(userId);
      }

      match /transactions/{transactionId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(transactionId) && isValidTransaction(request.resource.data);
        allow update: if isOwner(userId)
          && isValidId(transactionId)
          && isValidTransaction(request.resource.data)
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isOwner(userId);
      }

      match /backups/{backupId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(backupId) && isValidBackup(request.resource.data);
        allow delete: if isOwner(userId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
